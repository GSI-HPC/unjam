// From a v* tag to installable packages: the jobs of publish.yml, then what publishing the
// draft release starts (pages.yml, mise-install.yml).
const X = [8, 170, 332, 494, 656];
const steps = [
  { x: X[0], y: 43, t: 'tag v*', d: ['on main'], c: 's-purple' },
  { x: X[1], y: 43, t: 'verify', d: ['version, CHANGELOG'], c: '' },
  { x: X[2], y: 8, t: 'checks', d: ['fmt, clippy, tests,', 'reuse, deny, gates'], c: '' },
  { x: X[2], y: 78, t: 'integration', d: ['3 sind clusters'], c: '' },
  { x: X[3], y: 43, t: 'binaries', d: ['musl amd64 + arm64', 'attested'], c: 's-frost' },
  { x: X[4], y: 43, t: 'RPMs', d: ['EL 9, EL 10, Fedora', 'signed, attested'], c: 's-frost' },
  { x: X[4], y: 166, t: 'draft release', d: ['assets + checksums'], c: '' },
  { x: X[3], y: 166, t: 'crates.io', d: ['trusted publishing', 'after a review'], c: '' },
  { x: X[2], y: 166, t: 'publish draft', d: ['by hand'], c: 's-orange' },
  { x: X[1], y: 262, t: 'Pages', d: ['docs at /', 'dnf repo at /rpm/'], c: 's-green' },
  { x: X[2], y: 262, t: 'dnf install test', d: ['EL 9, EL 10, Fedora'], c: 's-green' },
  { x: X[3], y: 262, t: 'mise install test', d: ['amd64, arm64'], c: 's-green' },
];
const W = 136, H = 58;
const c = (i: number, side: 'r' | 'l' | 't' | 'b') => {
  const s = steps[i];
  return side === 'r' ? [s.x + W, s.y + H / 2] : side === 'l' ? [s.x, s.y + H / 2] : side === 't' ? [s.x + W / 2, s.y] : [s.x + W / 2, s.y + H];
};
const edges: [number, string, number, string][] = [
  [0, 'r', 1, 'l'], [1, 'r', 2, 'l'], [1, 'r', 3, 'l'], [2, 'r', 4, 'l'], [3, 'r', 4, 'l'], [4, 'r', 5, 'l'],
  [5, 'b', 6, 't'], [6, 'l', 7, 'r'], [7, 'l', 8, 'r'], [8, 'b', 9, 't'], [8, 'b', 11, 't'], [9, 'r', 10, 'l'],
];
---

<svg class="uj-d" viewBox="0 0 800 328" role="img" aria-labelledby="rl-t">
  <title id="rl-t">A v* tag on main runs verify, then checks and integration tests, then attested static binaries, then signed RPMs, then a draft release, then crates.io. Publishing the draft by hand rebuilds GitHub Pages with the docs and the dnf repository and tests dnf and mise installs.</title>
  <defs>
    <marker id="rl-h" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path class="head" d="M0 0L8 4L0 8z" /></marker>
  </defs>
  {
    edges.map(([a, sa, b, sb]) => {
      const [x1, y1] = c(a, sa as never), [x2, y2] = c(b, sb as never);
      const mx = (x1 + x2) / 2, my = (y1 + y2) / 2;
      const d = sa === 'r' || sa === 'l' ? `M${x1} ${y1} C${mx} ${y1} ${mx} ${y2} ${x2} ${y2}` : `M${x1} ${y1} C${x1} ${my} ${x2} ${my} ${x2} ${y2}`;
      return <path d={d} class="edge" marker-end="url(#rl-h)" />;
    })
  }
  {
    steps.map((s) => (
      <g transform={`translate(${s.x} ${s.y})`}>
        <rect width={W} height={H} rx="8" class={`box ${s.c}`} />
        <text x="10" y={s.d.length > 1 ? 20 : 24} class="sm b">{s.t}</text>
        {s.d.map((d, k) => (
          <text x="10" y={(s.d.length > 1 ? 36 : 43) + k * 15} class="sm muted" style="font-size:11px">{d}</text>
        ))}
      </g>
    ))
  }
</svg>
